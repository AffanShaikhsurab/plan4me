# Which provider serves the chat models.
# One of: bedrock (default), openai, anthropic, gemini, ollama, moonshot.
# Non-Bedrock providers need: pip install -r requirements-providers.txt
LLM_PROVIDER=bedrock

# AWS / Bedrock  (only used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
# Credentials come from the standard AWS chain (real environment variables,
# ~/.aws/credentials, AWS_PROFILE, SSO). NOTE: setting AWS_ACCESS_KEY_ID here
# does NOT work for the API server - pydantic-settings reads this file into
# Settings without exporting to os.environ, and boto3 only reads os.environ.
# Use `aws configure --profile <name>` plus AWS_PROFILE in your shell.

# Bedrock model IDs (must be enabled in your account/region).
# DeepSeek V3.2 and GLM 4.7 Flash are served directly on Bedrock.
# Swap freely, e.g. EXTRACTION_MODEL_ID=deepseek.v3.2
EXTRACTION_MODEL_ID=zai.glm-4.7-flash
SYNTHESIS_MODEL_ID=deepseek.v3.2
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Chat provider credentials (set only the one you use) ---
# openai    -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible gateway. Leave blank for
# api.openai.com. (Keep this comment on its own line - python-dotenv
# treats a trailing comment after an EMPTY value as the value itself.)
OPENAI_BASE_URL=
# anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# gemini    -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# moonshot  -> https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# ollama    -> no key; just a reachable server
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the models for whichever provider is active. Leave blank
# to use that provider's default. (Bedrock also still reads the older
# EXTRACTION_MODEL_ID / SYNTHESIS_MODEL_ID above.)
EXTRACTION_MODEL=
SYNTHESIS_MODEL=

# --- Embeddings (clustering only) ---
# bedrock = Titan (needs AWS) | openai = any OpenAI-compatible /embeddings
# endpoint | local = keyless hashed TF-IDF, no network, weaker paraphrase
# matching. Most chat vendors serve no embeddings endpoint, so pairing a
# non-Bedrock chat provider with "local" (zero setup) or "openai" is normal.
EMBEDDING_PROVIDER=bedrock
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ingestion / selection strategy
NUM_CANDIDATES=50          # how many videos to search
TARGET_VIDEOS=10           # how many to actually process
FORCE_DEEPGRAM_TOP_N=5     # top-ranked videos always processed (Deepgram if no captions)
DEFAULT_MAX_VIDEOS=10
TRANSCRIPT_LANGUAGES=en
# Comma-separated fallback languages, e.g. en,hi

# Deepgram (transcription for caption-less top videos). Leave blank to disable.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Clustering
# Tuned for semantic embeddings. If unset and EMBEDDING_PROVIDER=local, the
# code falls back to 0.35, which suits lexical TF-IDF cosine. Setting this
# explicitly overrides that for every provider.
# DEDUPE_SIMILARITY_THRESHOLD=0.82

# Whisper fallback (only used if captions are missing AND faster-whisper installed)
ENABLE_WHISPER_FALLBACK=false
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage
DB_PATH=plan4me.db

# Frontend (set in frontend/.env.local, or export before `npm run dev`)
NEXT_PUBLIC_API_BASE=http://localhost:8000
